{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["score", "plan_implementation", "quality", "feedback", "feedback_structured", "rewrite", "passed", "evaluator_skill"],
  "properties": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "plan_implementation": {
      "type": "object",
      "required": ["overall", "notes"],
      "properties": {
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["overall", "breakdown"],
      "properties": {
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 },
        "breakdown": {
          "type": "object",
          "required": ["premise_grounding", "dilemma_validity", "neutrality", "option_coverage", "loss_disclosure"],
          "properties": {
            "premise_grounding": { "type": "integer", "minimum": 0, "maximum": 100 },
            "dilemma_validity": { "type": "integer", "minimum": 0, "maximum": 100 },
            "neutrality": { "type": "integer", "minimum": 0, "maximum": 100 },
            "option_coverage": { "type": "integer", "minimum": 0, "maximum": 100 },
            "loss_disclosure": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "feedback": { "type": "string" },
    "feedback_structured": {
      "type": "object",
      "required": ["high", "medium", "low"],
      "properties": {
        "high": { "$ref": "#/$defs/findings" },
        "medium": { "$ref": "#/$defs/findings" },
        "low": { "$ref": "#/$defs/findings" }
      },
      "additionalProperties": false
    },
    "rewrite": { "type": ["string", "null"] },
    "passed": { "type": "boolean" },
    "evaluator_skill": { "const": "question-evaluator" }
  },
  "$defs": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "message"],
        "properties": {
          "area": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
